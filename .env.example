# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=local                  # local | staging | production
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:5173

# --- Database --------------------------------------------------------------
# Async driver (asyncpg) is required. Alembic derives its own sync URL from this.
DATABASE_URL=postgresql+asyncpg://pdfapp:pdfapp@localhost:5432/pdfapp
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
GUEST_TOKEN_TTL_MINUTES=720

# --- Blob storage ----------------------------------------------------------
# STORAGE_BACKEND=local keeps uploads on disk (no Azure account needed for dev).
# STORAGE_BACKEND=azure uses Azure Blob Storage with private containers + SAS.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./var/blobs
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=documents
SAS_URL_TTL_MINUTES=15

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_BYTES=26214400          # 25 MiB

# --- Email -----------------------------------------------------------------
# EMAIL_BACKEND=console logs messages instead of sending them, so share
# notifications and the password-reset flow work end to end with no provider.
# The reset link appears in the backend log.
EMAIL_BACKEND=console              # console | resend
RESEND_API_KEY=
# Must be a verified sender on the Resend account. `onboarding@resend.dev`
# needs no domain but only delivers to the account owner's own address.
EMAIL_FROM=PDF Intelligence <onboarding@resend.dev>

# --- Password reset --------------------------------------------------------
PASSWORD_RESET_TTL_MINUTES=30

# --- AI (Google Gemini) ----------------------------------------------------
# Model availability changes over time and differs between API keys. If a model
# 404s, run `python scripts/list_models.py` to see what your key can use.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.7-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Must match EMBEDDING_DIM in migration 0001. Changing it means re-embedding
# every document, so do not edit this without a migration.
GEMINI_EMBEDDING_DIMENSIONS=768

# --- Retrieval / chunking --------------------------------------------------
CHUNK_TARGET_TOKENS=900
CHUNK_OVERLAP_TOKENS=150
RETRIEVAL_TOP_K=8
CHAT_HISTORY_TURNS=5
